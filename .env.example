# Application
AI_AGENT_APP_NAME="AI Agent Harness"
AI_AGENT_APP_VERSION="0.1.0"
AI_AGENT_DEBUG=true
AI_AGENT_ENVIRONMENT=development

# Server
AI_AGENT_HOST=0.0.0.0
AI_AGENT_PORT=8000
AI_AGENT_WORKERS=1

# Database
AI_AGENT_DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/ai_agent_harness
AI_AGENT_DATABASE_ECHO=false

# Redis
AI_AGENT_REDIS_URL=redis://localhost:6379/0

# LLM Configuration
# Provider type: openai, openrouter, custom
AI_AGENT_LLM_PROVIDER=openrouter
# API key for the LLM provider (OpenAI, OpenRouter, or any OpenAI-compatible service)
AI_AGENT_OPENAI_API_KEY=your_openai_api_key_here
# API base URL for any OpenAI-compatible provider
AI_AGENT_OPENAI_API_BASE=https://openrouter.ai/api/v1
# Default model (OpenRouter format: anthropic/claude-3-sonnet, openai/gpt-4o, etc.)
AI_AGENT_DEFAULT_MODEL=gpt-4

# Vector Database
AI_AGENT_CHROMA_HOST=localhost
AI_AGENT_CHROMA_PORT=8000
AI_AGENT_CHROMA_COLLECTION=ai_agent_harness

# Agent Configuration
AI_AGENT_MAX_ITERATIONS=10
AI_AGENT_MAX_TOKENS=4096
AI_AGENT_TEMPERATURE=0.7

# Security
AI_AGENT_SECRET_KEY=your_secret_key_here
AI_AGENT_ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Logging
AI_AGENT_LOG_LEVEL=INFO
AI_AGENT_LOG_FORMAT=json

# Memory
AI_AGENT_MEMORY_ENABLED=true
AI_AGENT_MEMORY_SHORT_TERM_MAX_SIZE=100
AI_AGENT_MEMORY_LONG_TERM_COLLECTION=ai_agent_harness
AI_AGENT_MEMORY_EPISODIC_DATABASE_URL=